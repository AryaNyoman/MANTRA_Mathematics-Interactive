# Dependensi worktree perombakan: dipasang sendiri dengan `npm ci`.
web/node_modules/

# graphify: yang di-commit hanya graph.json, GRAPH_REPORT.md, manifest.json, .graphify_labels.json
# (bekal worktree lain). HTML bisa dibuat ulang, sisanya jejak mesin atau log percobaan.
graphify-out/graph.html
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_chunk_*.json
graphify-out/.semantik*.log
graphify-out/.rantai.log
graphify-out/cost.json
graphify-out/memory/
.graphify_cache/
graphify-out/cache/
# cadangan harian otomatis graphify: duplikat graph.json, selalu bisa dibuat ulang
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Video 480p untuk PREVIEW Vercel: disalin dari media/uji-480p, TIDAK di-commit
# (repo membengkak tiap render ulang). Poster .jpg TETAP di-commit: kecil, dan
# klon bersih butuh poster. Vercel mengunggah mp4 dari disk lewat
# web/.vercelignore yang menggantikan .gitignore. Berkas yang sudah dilacak
# (beranda-*.mp4, poster lama) tidak terpengaruh.
web/public/anim/*.mp4
