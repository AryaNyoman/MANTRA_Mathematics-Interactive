# Asisten Tanya (rute /api/tanya). Isi nilainya di web/.env.local (lokal) dan di
# Vercel > Settings > Environment Variables (Production). Jangan pernah commit nilainya.
ANTHROPIC_API_KEY=
# Model, bawaan claude-haiku-4-5; ganti tanpa mengubah kode
ANTHROPIC_MODEL=
# Upstash Redis (paket gratis) untuk jatah 20 pertanyaan per IP per hari
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Batas harian per IP, bawaan 20
TANYA_BATAS_HARIAN=
# HANYA lokal: 1 = lewati pembatas (jangan diisi di Vercel)
TANYA_TANPA_PEMBATAS=
